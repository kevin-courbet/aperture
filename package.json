{
  "name": "aperture-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "A React chart component and widget library built on TanStack Charts.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aperture/catalog storybook",
    "storybook": "pnpm --filter @aperture/catalog storybook",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "package:check": "node scripts/check-package.mjs",
    "validate": "pnpm typecheck && pnpm build && pnpm test && pnpm package:check",
    "signoff:iq": "bash scripts/signoff-iq.sh",
    "signoff:install": "bash scripts/install-signoff.sh install",
    "signoff:check": "bash scripts/install-signoff.sh check",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
