{
  "name": "aperture-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "An opinionated React chart design system built on TanStack Charts.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run storybook --workspace @aperture/catalog",
    "storybook": "npm run storybook --workspace @aperture/catalog",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
