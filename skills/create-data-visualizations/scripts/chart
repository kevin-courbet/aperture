#!/usr/bin/env bun
import { readFile } from 'node:fs/promises'
import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { capabilities } from './lib/capabilities'
import { CliInputError, commandResult, diagnostic, ServiceUnavailableError, type CommandResult } from './lib/contracts'
import { validateJsonSchema } from './lib/json-schema'
import { catalogUrl, defaultCatalogUrl, listCatalogStories, previewStories, testStories } from './lib/catalog'
import { validateSpecSemantics } from './lib/spec'

const scriptDir = dirname(fileURLToPath(import.meta.url))
const skillDir = resolve(scriptDir, '..')
const rawArgs = Bun.argv.slice(2)
const jsonFlags = rawArgs.filter((arg) => arg === '--json').length
if (jsonFlags > 1) {
  console.log(JSON.stringify(commandResult('chart', null, [diagnostic('error', 'CLI_ARGUMENTS', '$', 'Use --json at most once.')]), null, 2))
  process.exit(2)
}
const args = rawArgs.filter((arg) => arg !== '--json')

const usage = `chart <command> [arguments] [--json]

Commands:
  capabilities
  schema <chart-spec|command-result|capabilities|diagnostic>
  validate-spec <file|->
  catalog status [--url <url>]
  catalog list [--url <url>]
  catalog preview <story-id> [story-id ...] [--url <url>]
  catalog test [story-id ...] [--repo <aperture-checkout>]

Environment:
  APERTURE_CATALOG_URL  Ladle catalog URL (default: ${defaultCatalogUrl})
  APERTURE_REPO         Aperture checkout for catalog test`

const output = (result: CommandResult, exitCode = result.ok ? 0 : 3) => {
  console.log(JSON.stringify(result, null, 2))
  process.exit(exitCode)
}

const invalid = (command: string, message: string): never =>
  output(commandResult(command, { usage }, [diagnostic('error', 'CLI_ARGUMENTS', '$', message)]), 2)

const readJson = async (file: string) => {
  const text = file === '-' ? await Bun.stdin.text() : await readFile(file, 'utf8')
  try {
    return JSON.parse(text) as unknown
  } catch (error) {
    throw new CliInputError(`Invalid JSON: ${error instanceof Error ? error.message : String(error)}`)
  }
}

const schemaNames: Record<string, string> = {
  'chart-spec': 'chart-spec.schema.json',
  'command-result': 'command-result.schema.json',
  capabilities: 'capabilities.schema.json',
  diagnostic: 'diagnostic.schema.json',
}

const runCatalog = async (rest: string[]) => {
  const operation = rest[0]
  if (!operation) invalid('catalog', 'Provide a catalog operation.')
  const command = `catalog.${operation}`
  const options: { url?: string; repo?: string } = {}
  const ids: string[] = []
  for (let index = 1; index < rest.length; index += 1) {
    const value = rest[index]!
    if (value === '--url' || value === '--repo') {
      const key = value === '--url' ? 'url' : 'repo'
      if (options[key] !== undefined) invalid(command, `Use ${value} at most once.`)
      const next = rest[index + 1]
      if (next === undefined || next.startsWith('--')) invalid(command, `Provide a value after ${value}.`)
      options[key] = next
      index += 1
    } else if (value.startsWith('--')) {
      invalid(command, `Unknown option: ${value}`)
    } else {
      ids.push(value)
    }
  }
  const catalog = () => catalogUrl(options.url ?? process.env.APERTURE_CATALOG_URL ?? defaultCatalogUrl)
  switch (operation) {
    case 'status': {
      if (ids.length || options.repo) invalid(command, 'status accepts only --url.')
      const url = catalog()
      const stories = await listCatalogStories(url)
      output(commandResult(command, { url, storyCount: stories.length }))
      break
    }
    case 'list': {
      if (ids.length || options.repo) invalid(command, 'list accepts only --url.')
      const url = catalog()
      output(commandResult(command, { url, stories: await listCatalogStories(url) }))
      break
    }
    case 'preview': {
      if (ids.length === 0 || options.repo) invalid(command, 'Provide at least one story ID from catalog list. preview accepts only --url.')
      const url = catalog()
      output(commandResult(command, { url, stories: await previewStories(url, ids) }))
      break
    }
    case 'test': {
      if (options.url) invalid(command, 'test runs in an Aperture checkout and accepts only --repo.')
      const repo = options.repo ?? process.env.APERTURE_REPO
      if (!repo) return invalid(command, 'Provide the Aperture checkout with --repo or APERTURE_REPO.')
      const { result, diagnostics } = await testStories(repo, ids)
      output(commandResult(command, result, diagnostics))
      break
    }
    default:
      invalid('catalog', `Unknown catalog operation: ${operation}`)
  }
}

try {
  const command = args[0]
  switch (command) {
    case 'capabilities':
      if (args.length !== 1) invalid(command, 'capabilities accepts no arguments.')
      output(commandResult(command, capabilities))
      break
    case 'schema': {
      const name = args[1]
      if (args.length !== 2 || !name || !schemaNames[name]) invalid(command, 'Provide a valid schema name.')
      const schema = JSON.parse(await readFile(resolve(skillDir, 'schemas', schemaNames[name]), 'utf8'))
      output(commandResult(command, { name, schema }))
      break
    }
    case 'validate-spec': {
      const file = args[1]
      if (args.length !== 2 || !file) invalid(command, 'Provide one JSON file path or -.')
      const spec = await readJson(file)
      const schema = JSON.parse(await readFile(resolve(skillDir, 'schemas', schemaNames['chart-spec']), 'utf8'))
      const schemaDiagnostics = validateJsonSchema(spec, schema)
      const diagnostics = [...schemaDiagnostics, ...validateSpecSemantics(spec)]
      output(commandResult(command, { file, schema: 'chart-spec@2.0' }, diagnostics))
      break
    }
    case 'catalog':
      await runCatalog(args.slice(1))
      break
    case 'help':
    case '--help':
    case '-h':
    case undefined:
      console.log(usage)
      process.exit(0)
    default:
      invalid(String(command), `Unknown command: ${command}`)
  }
} catch (error) {
  const message = error instanceof Error ? error.message : String(error)
  const code = typeof error === 'object' && error !== null && 'code' in error ? String(error.code) : ''
  const unavailable = error instanceof ServiceUnavailableError
  const invalidInput = error instanceof CliInputError || ['EACCES', 'EISDIR', 'ENOENT', 'EPERM'].includes(code)
  const command = args[0] === 'catalog' && args[1] ? `catalog.${args[1]}` : args[0] ?? 'chart'
  output(
    commandResult(command, null, [
      diagnostic('error', unavailable ? 'CLI_SERVICE_UNAVAILABLE' : invalidInput ? 'CLI_INPUT' : 'CLI_INTERNAL', '$', message),
    ]),
    unavailable ? 4 : invalidInput ? 3 : 5,
  )
}
