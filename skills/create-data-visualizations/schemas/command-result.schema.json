{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kevin-courbet.dev/schemas/create-data-visualizations/command-result-1.0.json",
  "title": "Chart CLI command result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "data", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "path", "message"],
        "properties": {
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
